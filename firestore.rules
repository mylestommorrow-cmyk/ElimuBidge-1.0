rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role is string && data.role in ['student', 'teacher', 'school_admin', 'platform_admin'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 50)) &&
             (!('mode' in data) || (data.mode is string && data.mode in ['school', 'independent'])) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('tokensBalance' in data) || (data.tokensBalance is number)) &&
             (!('quizzesTaken' in data) || (data.quizzesTaken is number)) &&
             (!('averageScore' in data) || (data.averageScore is number)) &&
             (!('completedTopicsCount' in data) || (data.completedTopicsCount is number)) &&
             (!('disabilityAccommodation' in data) || (data.disabilityAccommodation is string && data.disabilityAccommodation.size() <= 100)) &&
             (!('accessibilitySettings' in data) || (data.accessibilitySettings is map)) &&
             (!('lastQuizTitle' in data) || (data.lastQuizTitle is string && data.lastQuizTitle.size() <= 200)) &&
             (!('lastQuizScore' in data) || (data.lastQuizScore is number)) &&
             (!('lastQuizTotal' in data) || (data.lastQuizTotal is number));
    }

    // Validation helper for LearnerActivity
    function isValidLearnerActivity(data, userId) {
      return data.userId == userId &&
             data.type is string && data.type in ['quiz', 'coursework', 'competency', 'chat'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 100)) &&
             (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 50)) &&
             (!('score' in data) || (data.score is number)) &&
             (!('total' in data) || (data.total is number)) &&
             (!('competencyRubric' in data) || (data.competencyRubric in ['EE', 'ME', 'AE', 'BE']));
    }

    // Validation helper for ChatMessage
    function isValidChatMessage(data, userId) {
      return data.userId == userId &&
             data.role is string && data.role in ['user', 'model', 'system'] &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 10000 &&
             (!('groundingSources' in data) || (data.groundingSources is string && data.groundingSources.size() <= 2000));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying across all users

      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'displayName', 'email', 'role', 'gradeLevel', 'mode', 'photoURL',
                        'tokensBalance', 'quizzesTaken', 'averageScore', 'completedTopicsCount',
                        'disabilityAccommodation', 'accessibilitySettings', 'lastQuizTitle',
                        'lastQuizScore', 'lastQuizTotal', 'updatedAt'
                      ]);
      allow delete: if isOwner(userId);

      // Activities Subcollection
      match /activities/{activityId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(activityId) && isValidLearnerActivity(incoming(), userId);
        allow update: if isOwner(userId) && isValidLearnerActivity(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Chat History Subcollection
      match /chat_history/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId);
        allow update: if isOwner(userId) && isValidChatMessage(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
